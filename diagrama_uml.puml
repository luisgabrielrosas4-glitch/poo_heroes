@startuml
title T06 - Recompensas de misiones
skinparam classAttributeIconSize 0
skinparam linetype ortho

abstract class Personaje {
  # nombre: String
}

abstract class Heroe {
  # saldo: int
  + consultarSaldo(): int
  + acreditarRecompensa(m: Mision): boolean
  ~ recibirRecompensa(cantidad: int): void
}

class Batman {
  + resolverMision(m: Mision, respuesta: String): boolean
}

abstract class Reto

class Mision {
  - id: String
  - estado: String
  - reto: Reto
  - recompensa: int
  - recompensaAcreditada: boolean
  - partida: Partida
  + Mision(id: String, reto: Reto)
  + Mision(id: String, reto: Reto, recompensa: int)
  + completar(): void
  + getPartida(): Partida
  ~ asignarPartida(partida: Partida): void
  + getRecompensa(): int
  + isRecompensaAcreditada(): boolean
  ~ marcarRecompensaAcreditada(): boolean
}

class Partida {
  - misiones: List<Mision>
  - recompensasGlobales: int
  + agregarMision(m: Mision): void
  + acreditarRecompensa(h: Heroe, m: Mision): boolean
  + getRecompensasGlobales(): int
}

Personaje <|-- Heroe
Heroe <|-- Batman
Mision --> Reto
Partida "1" o-- "0..*" Mision : registra
Mision --> Partida : pertenece a
Heroe ..> Partida : solicita cobro

note bottom of Partida
  Verifica la misión, paga al héroe
  y suma el total en una sola operación.
  Si ya se cobró, devuelve false.
end note

note right of Mision
  Una misión solo puede estar en
  una partida. En Python los nombres
  de los métodos usan guion bajo.
end note
@enduml
