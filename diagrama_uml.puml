@startuml
title T05 - Secuencias y misiones independientes
skinparam classAttributeIconSize 0
skinparam linetype ortho

enum NivelDificultad {
  FACIL
  MEDIO
  DIFICIL
}

abstract class Reto {
  # descripcion: String
  # dificultad: NivelDificultad
  + evaluarRespuesta(respuesta: String): boolean
  + generarProblema(): void
  + aumentarDificultad(): void
  + setDificultad(nivel: NivelDificultad): void
}

class RetoSecuencia {
  - patronNumerico: List<Integer>
  - respuestaEsperada: int
  + RetoSecuencia(dificultad: NivelDificultad)
  + generarProblema(): void
  + aumentarDificultad(): void
  + setDificultad(nivel: NivelDificultad): void
  + copiar(): RetoSecuencia
  + mostrarSecuencia(): String
  + evaluarRespuesta(respuesta: String): boolean
}

abstract class Villano {
  + plantearMision(id: String, reto: Reto): Mision
  + complicarReto(reto: Reto): void
}
class Joker {
  + complicarReto(reto: Reto): void
}
class Mision {
  - reto: Reto
  + Mision(id: String, reto: Reto)
  + getReto(): Reto
  + procesarIntento(respuesta: String): boolean
}

Reto <|-- RetoSecuencia
Villano <|-- Joker
Reto --> NivelDificultad
Mision --> Reto : contiene
Mision ..> RetoSecuencia : copia al crear misión
Villano ..> Mision : crea
Joker ..> RetoSecuencia : aumenta dificultad

note right of RetoSecuencia
  Al cambiar el nivel se regeneran
  la secuencia visible y la respuesta.
  copiar() conserva el problema
  sin compartir el estado mutable.
end note

note bottom of RetoSecuencia
  En Python: patron_numerico,
  respuesta_esperada, generar_problema(),
  aumentar_dificultad(), mostrar_secuencia().
  dificultad es una propiedad con setter.
end note
@enduml
