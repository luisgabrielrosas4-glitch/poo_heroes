@startuml
title T06 - Recompensas de misiones
skinparam classAttributeIconSize 0
skinparam linetype ortho

abstract class Personaje {
  # nombre: String
}

abstract class Heroe {
  # saldo: int
  + consultarSaldo(): int
  + acreditarRecompensa(m: Mision): boolean
}

class Batman {
  + resolverMision(m: Mision, respuesta: String): boolean
}

class Mision {
  - id: String
  - estado: String
  - reto: Reto
  - recompensa: int
  - recompensaAcreditada: boolean
  + Mision(id: String, reto: Reto)
  + Mision(id: String, reto: Reto, recompensa: int)
  + completar(): void
  + getRecompensa(): int
  + isRecompensaAcreditada(): boolean
  + marcarRecompensaAcreditada(): boolean
}

class Partida {
  - misiones: List<Mision>
  - recompensasGlobales: int
  + agregarMision(m: Mision): void
  + acreditarRecompensa(h: Heroe, m: Mision): boolean
  + getRecompensasGlobales(): int
}

abstract class Reto {
  + evaluarRespuesta(respuesta: String): boolean
}

Personaje <|-- Heroe
Heroe <|-- Batman
Mision --> Reto : contiene
Partida "1" o-- "0..*" Mision : guarda
Heroe ..> Mision : cobra
Partida ..> Heroe : acredita

note right of Mision
  Guarda el monto y si ya se pagó.
  No paga si está activa, bloqueada
  o si la recompensa ya se cobró.
end note

note bottom of Partida
  Suma el total solamente cuando
  el héroe acredita la recompensa.
  En Python los métodos usan
  nombres con guion bajo.
end note
@enduml
