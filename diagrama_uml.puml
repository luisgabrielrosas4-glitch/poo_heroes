@startuml
title T05 - Reto de secuencias
skinparam classAttributeIconSize 0
skinparam linetype ortho

enum NivelDificultad {
  FACIL
  MEDIO
  DIFICIL
}

abstract class Reto {
  # descripcion: String
  # dificultad: NivelDificultad
  + evaluarRespuesta(respuesta: String): boolean
  + generarProblema(): void
  + aumentarDificultad(): void
}

class RetoSecuencia {
  - patronNumerico: List<Integer>
  - respuestaEsperada: int
  + RetoSecuencia(dificultad: NivelDificultad)
  + generarProblema(): void
  + aumentarDificultad(): void
  + mostrarSecuencia(): String
  + evaluarRespuesta(respuesta: String): boolean
}

abstract class Villano {
  + plantearMision(id: String, r: Reto): Mision
  + complicarReto(r: Reto): void
}

class Joker {
  + complicarReto(r: Reto): void
}

class Mision {
  - reto: Reto
  + procesarIntento(respuesta: String): boolean
}

Reto <|-- RetoSecuencia
Villano <|-- Joker
Reto --> NivelDificultad
Mision --> Reto : contiene
Villano ..> Mision : crea
Joker ..> RetoSecuencia : sube nivel


note right of RetoSecuencia
  En Python se llaman:
  patron_numerico, respuesta_esperada
  generar_problema()
  mostrar_secuencia()
  evaluar_respuesta()
  aumentar_dificultad()
end note
@enduml
